{
  "name": "vite-vue3-temp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">= 22.18",
    "pnpm": ">= 11"
  },
  "scripts": {
    "start": "cross-env VITE_ENABLE_HTTPS=true vite --mode development",
    "build": "pnpm clean &&cross-env NODE_OPTIONS=--max-old-space-size=16384 vite build --mode production",
    "preview": "cross-env VITE_ENABLE_HTTPS=true vite preview",
    "analyzer": "cross-env VITE_ENABLE_ANALYZER=true pnpm build",
    "uploadToSentry": "cross-env UPLOAD_TO_SENTRY=true pnpm build",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "pnpm type-check:app && pnpm type-check:node && pnpm type-check:test",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "commit": "czg",
    "cspell": "cspell",
    "checkCssVars": "tsx scripts/cssVars/checkCssVars.ts",
    "format": "prettier . --write",
    "lint": "pnpm lint:script && pnpm lint:style && pnpm lint:md",
    "lint:check": "eslint . --no-error-on-unmatched-pattern && stylelint '**/*.{css,scss,less,vue}' && markdownlint-cli2 && prettier . --check",
    "lint:script": "eslint . --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint '**/*.{css,scss,less,vue}' --fix",
    "lint:md": "markdownlint-cli2",
    "orval": "orval",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --no-warn-ignored",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{css,scss,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx|*.vue|*.css|*.scss|*.less)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/browser": "^10.11.0",
    "@sentry/core": "^10.11.0",
    "@sentry/vue": "^10.11.0",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "js-cookie": "^3.0.8",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^4.3.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.3.0",
    "@unocss/transformer-directives": "^66.10.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.5",
    "chalk": "^6.0.0",
    "code-inspector-plugin": "^2.0.8",
    "cross-env": "^10.1.0",
    "cspell": "^10.2.2",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "^0.23.2",
    "openapi3-ts": "^4.6.1",
    "orval": "^8.29.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unocss": "^66.10.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
