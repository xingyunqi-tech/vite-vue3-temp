{
  "name": "vite-vue3-temp",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "start": "vite --mode development",
    "start:https": "cross-env VITE_ENABLE_HTTPS=true vite --mode development",
    "build": "npm run clean && npm run i18n:exportLocale && cross-env NODE_OPTIONS=--max-old-space-size=16384 vite build --mode production",
    "preview": "vite preview",
    "preview:https": "cross-env VITE_ENABLE_HTTPS=true vite preview",
    "analyzer": "cross-env VITE_ENABLE_ANALYZER=true npm run build",
    "uploadToSentry": "cross-env UPLOAD_TO_SENTRY=true npm run build",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "vue-tsc --noEmit",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "commit": "cross-env NODE_OPTIONS=\"--experimental-transform-types --disable-warning ExperimentalWarning\" czg",
    "cspell": "cspell *",
    "checkCssVars": "tsx scripts/cssVars/checkCssVars.ts",
    "format": "prettier . --write",
    "lint": "npm run lint:script && npm run lint:style && npm run lint:md",
    "lint:script": "eslint src/**/*.{js,jsx,ts,tsx} --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint 'src/**/*.{css,scss,less,vue}' --fix",
    "lint:md": "markdownlint-cli2 '**/*.{md}'",
    "i18n": "npx tsx scripts/i18n/index.ts --interactive",
    "i18n:exportLocale": "npx tsx scripts/i18n/exportLocale.ts",
    "prepare": "npx husky"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:script"
    ],
    "*.{css,scss,less}": [
      "npm run lint:style"
    ],
    "*.md": [
      "npm run lint:md"
    ],
    "*": [
      "npm run cspell",
      "pretty-quick --staged"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/browser": "^10.11.0",
    "@sentry/core": "^10.11.0",
    "@sentry/vue": "^10.11.0",
    "axios": "^1.11.0",
    "core-js": "^3.45.1",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.2",
    "gsap": "^3.13.0",
    "js-cookie": "^3.0.5",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "ts-md5": "^2.0.1",
    "vue": "^3.5.21",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.35.0",
    "@sentry/vite-plugin": "^4.3.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.1",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.6.2",
    "code-inspector-plugin": "^1.2.10",
    "commitizen": "^4.3.1",
    "conventional-changelog-atom": "^5.0.0",
    "cross-env": "^10.0.0",
    "cspell": "^9.2.1",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-vue": "^10.4.0",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "inquirer": "^12.9.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "markdownlint-cli2": "^0.18.1",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^8.2.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.92.1",
    "stylelint": "^16.24.0",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.6",
    "yargs": "^18.0.0"
  }
}
