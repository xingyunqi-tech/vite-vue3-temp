# api配置
# VITE_BASEURL = ''

# 需要给较老浏览器补 core-js polyfill 时置为 'true'（只给 modern 包注入，不产出 legacy 包，会增加构建时间）。
# 命令行覆盖：VITE_LEGACY=true pnpm build
# VITE_LEGACY = 'false'

# 部署路径：静态资源 base 与 vue-router base 的取值。
# 非根路径部署时改成对应子路径（如 '/admin/'），否则静态资源 404。
VITE_BASE_PATH = '/'

# Sentry（DSN 留空则不初始化，按项目填写；上传 sourcemap 的 SENTRY_AUTH_TOKEN 只放 .env.local）
VITE_SENTRY_DSN = ''
SENTRY_ORG = ''
SENTRY_PROJECT = ''
